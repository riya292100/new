# QuickCart Monorepo Environment Configuration Template
# Copy this file to .env and fill in values — never commit the real .env file.
#
# Generate a JWT secret with:  openssl rand -hex 32
# Generate a DB password with: openssl rand -base64 24

# ==============================================================================
# 1. Database Configuration (PostgreSQL 16)
# ==============================================================================
POSTGRES_DB=quickcart_db
POSTGRES_USER=quickcart_user
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quickcart_db

# ==============================================================================
# 2. Redis Cache & Distributed Lock
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# 3. Apache Kafka Event Streaming
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# ==============================================================================
# 4. Spring Boot Backend Service (Java 21)
# ==============================================================================
PORT=8080
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Generate with:  openssl rand -hex 32
QUICKCART_APP_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Payment gateway (use sandbox/test keys for development)
PAYMENT_PROVIDER=mock_razorpay
RAZORPAY_KEY_ID=CHANGE_ME_rzp_test_key_id
RAZORPAY_KEY_SECRET=CHANGE_ME_rzp_test_key_secret
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
QUICKCART_APP_PAYMENT_SECRET=CHANGE_ME_webhook_secret

# Demo Seeding Controls & Credentials (development only)
QUICKCART_SEEDING_ENABLED=true
QUICKCART_DEMO_ADMIN_PASSWORD=CHANGE_ME_admin_password
QUICKCART_DEMO_DRIVER_PASSWORD=CHANGE_ME_driver_password
QUICKCART_DEMO_CUSTOMER_PASSWORD=CHANGE_ME_customer_password

# ==============================================================================
# 5. Python AI Demand Engine (FastAPI / Port 8082)
# ==============================================================================
AI_ENGINE_PORT=8082
AI_ENGINE_ENV=development
MODEL_CACHE_DIR=./models/cache

# ==============================================================================
# 6. Go Spatial Telemetry Service (Port 8085)
# ==============================================================================
TELEMETRY_PORT=8085
TELEMETRY_REDIS_ADDR=localhost:6379
TELEMETRY_LOG_LEVEL=info

# ==============================================================================
# 7. Frontend Client (React 18 + Vite / Port 5173)
# ==============================================================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_BASE_URL=http://localhost:8080/ws-quickcart
VITE_DEMO_CUSTOMER_EMAIL=customer@quickcart.com
VITE_DEMO_CUSTOMER_PASSWORD=CHANGE_ME_customer_password
VITE_DEMO_DRIVER_EMAIL=driver@quickcart.com
VITE_DEMO_DRIVER_PASSWORD=CHANGE_ME_driver_password
VITE_DEMO_ADMIN_EMAIL=admin@quickcart.com
VITE_DEMO_ADMIN_PASSWORD=CHANGE_ME_admin_password

# ==============================================================================
# 8. Observability / Error Tracking (optional)
# ==============================================================================
# Set to your Sentry DSN to enable frontend error reporting.
# Leave empty (or omit) to disable — the app degrades gracefully.
VITE_SENTRY_DSN=
