# QuickCart Monorepo Environment Configuration Template
# Copy this file to .env or set environment variables accordingly in your runtime.

# ==============================================================================
# 1. Database Configuration (PostgreSQL 16 / Production)
# ==============================================================================
POSTGRES_DB=quickcart_db
POSTGRES_USER=quickcart_user
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quickcart_db

# ==============================================================================
# 2. Redis Cache & Distributed Lock
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================================================================
# 3. Apache Kafka Event Streaming
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=false

# ==============================================================================
# 4. Spring Boot Backend Service (Java 21)
# ==============================================================================
PORT=8081
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
PAYMENT_PROVIDER=mock_razorpay
RAZORPAY_KEY_ID=rzp_test_quickcartKey2026
RAZORPAY_KEY_SECRET=rzp_secret_quickcartSecret2026
RAZORPAY_WEBHOOK_SECRET=quickcart_webhook_secret_2026

# Demo Seeding Controls & Credentials
QUICKCART_SEEDING_ENABLED=true
QUICKCART_DEMO_ADMIN_PASSWORD=Admin@123
QUICKCART_DEMO_DRIVER_PASSWORD=Driver@123
QUICKCART_DEMO_CUSTOMER_PASSWORD=Customer@123

# ==============================================================================
# 5. Python AI Demand Engine (FastAPI / Port 8082)
# ==============================================================================
AI_ENGINE_PORT=8082
AI_ENGINE_ENV=development
MODEL_CACHE_DIR=./models/cache

# ==============================================================================
# 6. Go Spatial Telemetry Service (Port 8085)
# ==============================================================================
TELEMETRY_PORT=8085
TELEMETRY_REDIS_ADDR=localhost:6379
TELEMETRY_LOG_LEVEL=info

# ==============================================================================
# 7. Frontend Client (React 18 + Vite / Port 5173)
# ==============================================================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081/api
VITE_WS_BASE_URL=http://localhost:8081/ws-quickcart
VITE_DEMO_CUSTOMER_EMAIL=customer@quickcart.com
VITE_DEMO_CUSTOMER_PASSWORD=Customer@123
VITE_DEMO_DRIVER_EMAIL=driver@quickcart.com
VITE_DEMO_DRIVER_PASSWORD=Driver@123
VITE_DEMO_ADMIN_EMAIL=admin@quickcart.com
VITE_DEMO_ADMIN_PASSWORD=Admin@123
