{
  "name": "quickcart-monorepo",
  "version": "1.2.0",
  "private": true,
  "description": "QuickCart - 10-Minute Hyperlocal Fullstack Grocery Delivery Application",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "cd frontend && npm run dev",
