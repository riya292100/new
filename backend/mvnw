#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Executable for Linux / macOS / Unix
# ----------------------------------------------------------------------------

set -e

if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_CMD="$JAVA_HOME/bin/java"
else
    JAVA_CMD="java"
fi

if ! command -v mvn >/dev/null 2>&1; then
    echo "Maven is not installed in PATH. Please install Maven or configure MAVEN_HOME." >&2
    exit 1
fi

exec mvn "$@"
